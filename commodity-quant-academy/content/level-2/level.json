        {
          "id": "l2-m3-l3",
          "title": "merge and join",
          "objectives": [
            "Join trades to FX and price tables",
            "Avoid many-to-many blow-ups"
          ]
        },
        {
          "id": "l2-m3-l4",
          "title": "Reshaping",
          "objectives": [
            "melt and stack for report layouts",
            "Tidy vs wide data"
          ]
        }
      ],
      "boss": {
        "id": "l2-m3-boss",
        "title": "Boss battle: Aggregation"
      }
    },
    {
      "id": "l2-m4",
      "title": "Time series",
      "lessons": [
        {
          "id": "l2-m4-l1",
          "title": "Dates and DatetimeIndex",
          "objectives": [
