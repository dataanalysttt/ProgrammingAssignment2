          "objectives": [
            "Open, read and write files with context managers",
            "Parse a broker recap file line by line"
          ]
        },
        {
          "id": "l2-m1-l2",
          "title": "The csv module",
          "objectives": [
            "Read the trade book with csv.DictReader",
            "Write a filtered confirmation list"
          ]
        },
        {
          "id": "l2-m1-l3",
          "title": "Excel in and out",
          "objectives": [
            "Read and write .xlsx with pandas/openpyxl",
            "Produce a formatted position sheet"
          ]
        },
        {
          "id": "l2-m1-l4",
          "title": "Paths and folders",
          "objectives": [
            "Use pathlib to handle monthly report folders",
            "Batch-process a folder of invoices"
          ]
        }
      ],
      "boss": {
        "id": "l2-m1-boss",
        "title": "Boss battle: Files and CSV"
      }
    },
    {
      "id": "l2-m2",
      "title": "pandas core",
      "lessons": [
        {
          "id": "l2-m2-l1",
          "title": "Series and DataFrames",
          "objectives": [
