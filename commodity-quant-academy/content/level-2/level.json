        {
          "id": "l2-m6-l1",
          "title": "Messy counterparty names",
          "objectives": [
            "Normalise names and map aliases",
            "Detect duplicates"
          ]
        },
        {
          "id": "l2-m6-l2",
          "title": "Types and units",
          "objectives": [
            "Fix tonnes stored as text, kt vs t",
            "Validate ranges"
          ]
        },
        {
          "id": "l2-m6-l3",
          "title": "Reconciliation",
          "objectives": [
            "Match two trade lists and report breaks",
            "Anti-joins with indicator=True"
          ]
        }
      ],
      "boss": {
        "id": "l2-m6-boss",
        "title": "Boss battle: Cleaning"
      }
    },
    {
      "id": "l2-m7",
      "title": "SQL from Python",
      "lessons": [
        {
          "id": "l2-m7-l1",
