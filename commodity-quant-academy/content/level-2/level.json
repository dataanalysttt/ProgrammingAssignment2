          ]
        },
        {
          "id": "l2-m7-l2",
          "title": "Queries into pandas",
          "objectives": [
            "read_sql for position reports",
            "GROUP BY in SQL vs pandas"
          ]
        },
        {
          "id": "l2-m7-l3",
          "title": "Building a small trade database",
          "objectives": [
            "Schema for trades, invoices, prices",
            "Indexes and joins"
          ]
        }
      ],
      "boss": {
        "id": "l2-m7-boss",
        "title": "Boss battle: SQL from Python"
      }
    }
  ],
  "placement": {
