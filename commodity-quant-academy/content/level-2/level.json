        {
          "id": "l2-m2-l4",
          "title": "Sorting and ranking",
          "objectives": [
            "Rank counterparties by tonnage",
            "nlargest and sort_values"
          ]
        }
      ],
      "boss": {
        "id": "l2-m2-boss",
        "title": "Boss battle: pandas core"
      }
    },
    {
      "id": "l2-m3",
      "title": "Aggregation",
      "lessons": [
        {
          "id": "l2-m3-l1",
          "title": "groupby",
          "objectives": [
            "Tonnes and value by counterparty and month",
